{
  "name": "time",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm wasm:stage && pnpm --filter @time/web build",
    "dev": "pnpm wasm:stage && pnpm --filter @time/web dev",
    "preview": "pnpm --filter @time/web preview",
    "test": "pnpm --filter @time/core test && pnpm wasm:stage && pnpm --filter @time/web test",
    "test:coverage": "pnpm --filter @time/core test:coverage",
    "test:e2e": "pnpm build && pnpm --filter @time/e2e test",
    "wasm:stage": "tsx scripts/stage-wasm.ts"
  },
  "devDependencies": {
    "@effect/platform": "^0.94.0",
    "@effect/platform-node": "^0.104.0",
    "@effect/vitest": "^0.30.0",
    "@types/node": "^22.13.10",
    "effect": "^3.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
